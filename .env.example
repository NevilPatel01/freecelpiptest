# =============================================================================
# FreeCELPIPTest — Appwrite Cloud + static site (local: copy to .env.local)
# Never commit .env or real secrets. DigitalOcean App Platform: same keys as
# BUILD_TIME environment variables (plus encrypted APPWRITE_API_KEY).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Site URL (required for production build + OAuth)
# -----------------------------------------------------------------------------
# Local: http://localhost:3000
# DigitalOcean: https://YOUR-APP.ondigitalocean.app (or custom domain)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 2) Appwrite Cloud — API endpoint (usually unchanged)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"

# Project Settings → General → Project ID
NEXT_PUBLIC_APPWRITE_PROJECT_ID=""

# Databases → your database → Database ID
NEXT_PUBLIC_APPWRITE_DATABASE_ID=""

# Collection IDs (Databases → collection → Collection ID)
NEXT_PUBLIC_APPWRITE_COLLECTION_BLOG_POSTS=""
NEXT_PUBLIC_APPWRITE_COLLECTION_NEWSLETTER=""
NEXT_PUBLIC_APPWRITE_COLLECTION_FEEDBACK=""

# Storage → bucket for blog images (optional; admin cover uploads)
NEXT_PUBLIC_APPWRITE_BUCKET_BLOG_IMAGES=""

# -----------------------------------------------------------------------------
# 3) Server API key (build + scripts only — NEVER expose to browser)
# -----------------------------------------------------------------------------
# Appwrite → Project → API Keys → create key with scopes: databases.read,
# databases.write (and storage.read/write if you use blog images bucket).
# Used by: npm run build (prebuild blog slugs), npm run seed:blog
APPWRITE_API_KEY=""

# -----------------------------------------------------------------------------
# 4) Admin UI (/admin) — checked in the browser after login
# -----------------------------------------------------------------------------
# Comma-separated Google account emails that may use /admin
NEXT_PUBLIC_ADMIN_EMAIL=""
# Optional: Appwrite Teams — team ID whose members are admins
# NEXT_PUBLIC_APPWRITE_ADMIN_TEAM_ID=""

# -----------------------------------------------------------------------------
# 5) Optional
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL=""
# NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_APPLICATIONINSIGHTS_CONNECTION_STRING=""

# =============================================================================
# Appwrite Console checklist (Appwrite Cloud)
# =============================================================================
#
# Auth → Sign-in methods: enable Google (and configure Google Cloud OAuth client).
#
# Auth → Platforms → Web: add your real site hostname (e.g. app on DigitalOcean).
#   This app uses success redirect: {YOUR_SITE}/dashboard (see appwrite-auth-provider).
#
# Databases: create database + collections with attributes:
#
#   blog_posts (example names — IDs go in NEXT_PUBLIC_APPWRITE_COLLECTION_*):
#     title (string), slug (string), excerpt (string), content (string, large),
#     category (string), tags (string array), featuredImage (string),
#     readingTime (integer), author (string), published (boolean),
#     publishedAt (datetime string ISO), views (integer)
#
#   newsletter:
#     email (string), active (boolean)
#
#   feedback:
#     name (string), email (string), message (string), rating (integer, optional),
#     category (string), status (string, e.g. "new")
#
# Permissions: allow guests create where needed (newsletter, feedback); restrict
# read/update on blog admin paths per your security model. See Appwrite docs.
#
# Storage: bucket for blog images; set file-level or bucket read if public URLs used.

# =============================================================================
# What to share when asking for help (e.g. in Cursor)
# =============================================================================
# OK:  error messages, which step fails (build vs runtime), branch name,
#       whether values are set (without pasting values), Appwrite Cloud vs self-host.
# OK:  redacted .env — show variable NAMES only, or replace IDs with ***.
# NEVER: APPWRITE_API_KEY, OAuth client secrets, full session cookies, passwords.

# =============================================================================
# Git branches (this repo)
# =============================================================================
# Active development and CI/CD targets: branch `dev` (push here for architecture work).
# Default GitHub branch for visitors/portfolio can stay `main`; merge dev → main when ready.
# Point DigitalOcean + .do/app.yaml at `dev` for preview/staging builds.

# =============================================================================
# DigitalOcean App Platform
# =============================================================================
# See .do/app.yaml — build: npm ci && npm run build, output: out/
# Set all NEXT_PUBLIC_* and APPWRITE_API_KEY as BUILD_TIME (API key encrypted).
