# =============================================================================
# FreeCELPIPTest — PostgreSQL (Prisma) + NextAuth (Google)
# Copy to .env or .env.local. Never commit real secrets.
# =============================================================================

# Site URL (canonical links, OAuth callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/freecelpip?schema=public"

# -----------------------------------------------------------------------------
# NextAuth — generate secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# Optional alias some hosts use:
# NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Admin portal (/admin) — comma-separated Google account emails
# -----------------------------------------------------------------------------
ADMIN_EMAIL="you@example.com"

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL="contact@yourdomain.com"
# GOOGLE_SITE_VERIFICATION=""
# APPLICATIONINSIGHTS_CONNECTION_STRING=""

# -----------------------------------------------------------------------------
# Local setup
# -----------------------------------------------------------------------------
# npm install
# npx prisma db push   # or: npm run db:migrate
# npm run dev
#
# Blog posts: add/edit MDX under content/blog (see content/blog/README.md).
