# =============================================================================
# FreeCELPIPTest — Appwrite Cloud + static site (local: copy to .env.local)
# Never commit .env or real secrets. DigitalOcean App Platform: same keys as
# BUILD_TIME environment variables (plus encrypted APPWRITE_API_KEY).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Site URL (required for production build + OAuth)
# -----------------------------------------------------------------------------
# Local: http://localhost:3000
# DigitalOcean: https://YOUR-APP.ondigitalocean.app (or custom domain)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 2) Appwrite Cloud — API endpoint (must match your project's region)
# -----------------------------------------------------------------------------
# Use the exact URL from Appwrite Console → Project → Settings (API / Network).
# Generic https://cloud.appwrite.io/v1 often fails with "not accessible in this region".
# Regional examples: https://tor.cloud.appwrite.io/v1 (Toronto),
#   https://fra.cloud.appwrite.io/v1, https://nyc.cloud.appwrite.io/v1, …
# See: https://appwrite.io/docs/products/network/endpoints
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://tor.cloud.appwrite.io/v1"

# Project Settings → General → Project ID
NEXT_PUBLIC_APPWRITE_PROJECT_ID=""

# Databases → your database → Database ID
NEXT_PUBLIC_APPWRITE_DATABASE_ID=""

# Collection IDs — run `npm run setup:appwrite` to create defaults, then paste IDs here:
#   blog_posts, newsletter, feedback (or override with SETUP_* env vars in the script)
NEXT_PUBLIC_APPWRITE_COLLECTION_BLOG_POSTS=""
NEXT_PUBLIC_APPWRITE_COLLECTION_NEWSLETTER=""
NEXT_PUBLIC_APPWRITE_COLLECTION_FEEDBACK=""

# Storage → bucket for blog images (optional; admin cover uploads)
NEXT_PUBLIC_APPWRITE_BUCKET_BLOG_IMAGES=""

# -----------------------------------------------------------------------------
# 3) Server API key (build + scripts only — NEVER expose to browser)
# -----------------------------------------------------------------------------
# Appwrite → Project → API Keys → create key with scopes:
#   databases.read, databases.write, storage.read, storage.write
# Used by: npm run build, npm run seed:blog, npm run setup:appwrite
APPWRITE_API_KEY=""

# -----------------------------------------------------------------------------
# 4) Admin UI (/admin) — checked in the browser after login
# -----------------------------------------------------------------------------
# Comma-separated Google account emails that may use /admin
NEXT_PUBLIC_ADMIN_EMAIL=""
# Optional: Appwrite Teams — team ID whose members are admins
# NEXT_PUBLIC_APPWRITE_ADMIN_TEAM_ID=""

# -----------------------------------------------------------------------------
# 5) Provision database (one-time)
# -----------------------------------------------------------------------------
# With PROJECT_ID, DATABASE_ID, and APPWRITE_API_KEY set above:
#   npm run setup:appwrite
# Creates collections blog_posts, newsletter, feedback + bucket blog_images (if missing).
# Add --ensure-database if the database ID does not exist yet.
#
# Optional overrides (before running the script):
# SETUP_COLLECTION_BLOG_POSTS=blog_posts
# SETUP_COLLECTION_NEWSLETTER=newsletter
# SETUP_COLLECTION_FEEDBACK=feedback
# SETUP_BUCKET_BLOG_IMAGES=blog_images
#
# Collection schemas (for manual Console setup):
#   blog_posts: title, slug, excerpt, content (text), category, tags (string[]),
#     featuredImage, readingTime (int), author, published (bool), publishedAt (datetime|null), views (int)
#   newsletter: email (email), active (bool) — unique index on email
#   feedback: name, email, message, rating (int optional 1–5), category, status
#
# Auth: enable Google provider; Web platform URLs = your site + http://localhost:3000

# -----------------------------------------------------------------------------
