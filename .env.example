# =============================================================================
# FreeCELPIPTest — static site + Appwrite Cloud
# Copy to .env.local. Never commit real secrets.
# =============================================================================

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Appwrite (browser SDK — use NEXT_PUBLIC_*)
# Create project at https://cloud.appwrite.io — enable Auth → Google
# Add your site URL under Auth → Platforms (e.g. http://localhost:3000)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
NEXT_PUBLIC_APPWRITE_PROJECT_ID=""
NEXT_PUBLIC_APPWRITE_DATABASE_ID=""

# Collections (string attributes unless noted)
# Newsletter: email (string, unique optional)
# Feedback: name, email, message (string), rating (integer, optional), category (string), status (string)
NEXT_PUBLIC_APPWRITE_NEWSLETTER_COLLECTION_ID=""
NEXT_PUBLIC_APPWRITE_FEEDBACK_COLLECTION_ID=""

# Server-only API key is NOT required for this static client flow if
# collection permissions allow guest create (newsletter/feedback) and
# authenticated admin read/update — configure in Appwrite Console.

# -----------------------------------------------------------------------------
# Admin portal (/admin) — comma-separated emails matching the Google account
# NEXT_PUBLIC_* is required for static builds so the client can check access.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAIL="you@example.com"

# Optional duplicate (build-time only / non-client):
# ADMIN_EMAIL="you@example.com"

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL="contact@yourdomain.com"
# GOOGLE_SITE_VERIFICATION=""
# APPLICATIONINSIGHTS_CONNECTION_STRING=""

# -----------------------------------------------------------------------------
# Local (no server): blog is MDX under content/blog
# -----------------------------------------------------------------------------
# bun install && bun run dev
# bun run build && bun run preview:static

# Optional: Prisma + Postgres only if you use legacy scripts locally
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/freecelpip?schema=public"
