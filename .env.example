# =============================================================================
# FreeCELPIPTest – Environment variables
# Copy to .env and fill in values. Never commit .env.
# For Digital Ocean App Platform, see APP_PLATFORM_ENV.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Local: Docker Postgres (npm run db:docker) → port 5434
# Production: Set in App Platform from Digital Ocean Managed Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/freecelpip?schema=public"

# -----------------------------------------------------------------------------
# Auth – critical, keep secret (required in production)
# -----------------------------------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Or legacy name:
# NEXTAUTH_SECRET=""

# App URL (required in production for OAuth and redirects)
NEXTAUTH_URL="http://localhost:3000"
# Also set for canonical URLs and SEO (same as NEXTAUTH_URL in production):
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Google OAuth (required for sign-in and admin)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Admin access – critical, keep secret (required for /admin)
# -----------------------------------------------------------------------------
# Comma-separated emails that can access /admin
ADMIN_EMAIL=""

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Contact email on contact page (default: contact@<your-domain>)
# NEXT_PUBLIC_CONTACT_EMAIL=""

# Google Search Console verification
# GOOGLE_SITE_VERIFICATION=""

# Azure Application Insights (optional)
# APPLICATIONINSIGHTS_CONNECTION_STRING=""
